<Window x:Class="Mintada.Navigator.Views.ChangeCoinAttributesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mintada.Navigator.Views"
        mc:Ignorable="d"
        Title="Change Attributes" Height="780" Width="1100"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- First Line: Title & Subtitle -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Title:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TitleTextBox" Margin="0,0,0,0" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Subtitle:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="SubtitleTextBox" Margin="0,0,0,0" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,20"/>

                <!-- Section: Denomination & Shape -->
                <TextBlock Text="Denomination &amp; Shape" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Denomination:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DenominationTextBox" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Value Amount:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ValueAmountTextBox" Margin="0,0,0,15" Padding="5" ToolTip="Decimal value"/>
                    </StackPanel>

                    <!-- Column 2 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Denomination Info 1:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DenominationInfo1TextBox" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Value Amount (USD):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ValueAmountUsdTextBox" Margin="0,0,0,15" Padding="5" ToolTip="Decimal value"/>
                    </StackPanel>

                    <!-- Column 3 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Value Currency Symbol:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ValueCurrencySymbolTextBox" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Denomination Alt:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DenominationAltTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                    
                    <!-- Column 4 -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Shape:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ShapesComboBox" DisplayMemberPath="Name" Margin="0,0,0,15" Padding="5"/>
                        
                        <TextBlock Text="Shape Info:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ShapeInfoTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5,0,20"/>

                <!-- Section: Measurements -->
                <TextBlock Text="Measurements" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Weight (g):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightTextBox" Margin="0,0,0,15" Padding="5" ToolTip="Decimal values only (e.g. 1.25)"/>
                        
                        <TextBlock Text="Weight Info:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightInfoTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>

                    <!-- Column 2 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Diameter (mm):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DiameterTextBox" Margin="0,0,0,15" Padding="5" ToolTip="Decimal values only (e.g. 25.5)"/>
                        
                        <TextBlock Text="Diameter Info:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DiameterInfoTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>

                    <!-- Column 3 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Thickness (mm):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ThicknessTextBox" Margin="0,0,0,15" Padding="5" ToolTip="Decimal values only (e.g. 1.8)"/>
                        
                        <TextBlock Text="Thickness Info:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ThicknessInfoTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                    
                    <!-- Column 4 -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Size (TEXT):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="SizeTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                </Grid>
                
                
                <Separator Margin="0,5,0,20"/>

                <!-- Section: Periods & Rulers -->
                <TextBlock Text="Periods &amp;Rulers" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" Visibility="Collapsed"/>
                <Grid Margin="0,0,0,15" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Period:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PeriodsComboBox" Margin="0,0,0,0" Padding="5" DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ruler 1:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Ruler1ComboBox" Margin="0,0,0,0" Padding="5" DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ruler 2:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Ruler2ComboBox" Margin="0,0,0,0" Padding="5" DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Ruler 3:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Ruler3ComboBox" Margin="0,0,0,0" Padding="5" DisplayMemberPath="Name"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5,0,20" Visibility="Collapsed"/>
                
                <!-- Section: Dates -->
                <TextBlock Text="Dates" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Gregorian -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="StartDateTextBox" Margin="0,0,0,15" Padding="5"/>
                        
                        <TextBlock Text="End Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EndDateTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                    
                    <!-- Column 2: Native -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Start Native Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="StartNativeDateTextBox" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="End Native Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EndNativeDateTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>

                    <!-- Column 3: Mint -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Start Mint Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="StartMintDateTextBox" Margin="0,0,0,15" Padding="5"/>
                        
                        <TextBlock Text="End Mint Date:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EndMintDateTextBox" Margin="0,0,0,15" Padding="5"/>
                    </StackPanel>
                    
                    <!-- Column 4: Calendar System & Tools -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Calendar System:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CalendarSystemComboBox" Margin="0,0,0,15" Padding="5" DisplayMemberPath="Name"/>

                        <Button Content="Native &#x21C5; Mint" Click="MoveNativeMintButton_Click" Padding="10,5" Margin="0,21,0,15" ToolTip="Move/Swap values between Native and Mint fields"/>
                    </StackPanel>
                </Grid>
                
                <!-- Restrike Dates Section -->
                <Expander x:Name="RestrikeExpander" Header="Restrike and Erroneous Dates" Margin="0,10,0,0" IsExpanded="False" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" FontWeight="Bold">
                    <Grid Margin="0,5,0,0" TextElement.FontWeight="Normal">
                         <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/> 
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Restrike Date -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Restrike Date:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="Black"/>
                            <TextBox x:Name="RestrikeDateTextBox" Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>

                        <!-- Column 2: Restrike Start Mint -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Restrike Start Mint Date:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="Black"/>
                            <TextBox x:Name="RestrikeStartMintDateTextBox" Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>
                        
                        <!-- Column 3: Restrike End Mint -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Restrike End Mint Date:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="Black"/>
                            <TextBox x:Name="RestrikeEndMintDateTextBox" Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>
                        
                        <!-- Column 4: Erroneous Dates -->
                         <StackPanel Grid.Column="6">
                            <TextBlock Text="Erroneous Dates:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="Black"/>
                            <TextBox x:Name="ErroneousDatesTextBox" Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </Expander>
                
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" Width="80" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" Width="80" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
