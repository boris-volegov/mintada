<Window x:Class="Mintada.Navigator.Views.AddCoinTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Coin Type" Height="280" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinHeight="240"
        MinWidth="560">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Coin Type" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Issuer:" Width="70" VerticalAlignment="Center" Foreground="#555"/>
            <TextBlock x:Name="IssuerTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Coin ID:" Width="70" VerticalAlignment="Center" Foreground="#555"/>
                <TextBox x:Name="CoinTypeIdTextBox" Width="160" Padding="6" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ExistingCoinWarningTextBlock"
                       Margin="70,6,0,0"
                       Foreground="#CC0000"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="This coin type ID already exists. Clicking OK will reprocess and overwrite its current scraped data."/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="OK" Click="Ok_Click" Padding="22,7" Cursor="Hand"
                    Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50"/>
        </StackPanel>
    </Grid>
</Window>
